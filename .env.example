## ──────────────────────────────────────────────
# AutoReel Lite — Environment Variables
# ──────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://autoreel:autoreel@localhost:5432/autoreel"

# Cấu hình gửi mail (Thay bằng Gmail thật và Mật khẩu ứng dụng của khách)
EMAIL_SERVER="smtp://thond.topmedia.vn%40gmail.com:sywygivdgmryfngp@smtp.gmail.com:587"
EMAIL_FROM="thond.topmedia.vn@gmail.com"


# Redis (for BullMQ job queue)
REDIS_URL="redis://localhost:6379"
AUTH_URL="https://app.tioecommerce.io.vn"
NEXTAUTH_URL="https://app.tioecommerce.io.vn"

# NextAuth
AUTH_SECRET="generate-a-strong-random-secret-here"
# AUTH_URL="http://localhost:3000"
# Trust host in dev (set to true)
AUTH_TRUST_HOST=true

# Admin email — first user seeded as ADMIN
ADMIN_EMAIL="thond.topmedia.vn@gmail.com"

# ──────────────────────────────────────────────
# Mock Mode (set to "true" for dev without real API keys)
# ──────────────────────────────────────────────
USE_MOCK_PUBLISHERS="false"

# ──────────────────────────────────────────────
# Meta OAuth (Facebook + Instagram)
# ──────────────────────────────────────────────
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_REDIRECT_URI="http://localhost:3000/api/social/meta/callback"
META_GRAPH_API_VERSION="v26.0"

# ──────────────────────────────────────────────
# Google OAuth (YouTube + Google Drive)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/social/google/callback"


# ──────────────────────────────────────────────
# Upload Settings
# ──────────────────────────────────────────────
MAX_FILE_SIZE_MB="2028"
UPLOAD_DIR="./uploads"

# ──────────────────────────────────────────────
# RapidAPI (Video Downloader)
# ──────────────────────────────────────────────
RAPIDAPI_KEY="your-rapidapi-key-here"
RAPIDAPI_HOST="social-media-video-downloader.p.rapidapi.com"

# ──────────────────────────────────────────────
# SePay VietQR Payment & Webhook
# ──────────────────────────────────────────────
NEXT_PUBLIC_BANK_ID="MB"
NEXT_PUBLIC_BANK_ACCOUNT_NO="292222288888"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="NGUYEN DINH THO"
SEPAY_API_KEY="your-sepay-api-key"